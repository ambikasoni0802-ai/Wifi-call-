<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_call.xml
    Active call screen – shows peer info, status, timer, and call controls.
    Used for both outgoing (caller) and active incoming (callee) calls.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Peer avatar (large, centered) -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivPeerAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_default_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.2"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Peer display name -->
    <TextView
        android:id="@+id/tvPeerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="?attr/colorOnSurface"
        android:text="Name"
        app:layout_constraintTop_toBottomOf="@id/ivPeerAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Peer 4-digit ID -->
    <TextView
        android:id="@+id/tvPeerDigitId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="ID: 0000"
        app:layout_constraintTop_toBottomOf="@id/tvPeerName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call status text (e.g., "Calling…", "Connected") -->
    <TextView
        android:id="@+id/tvCallStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorPrimary"
        android:text="Calling…"
        app:layout_constraintTop_toBottomOf="@id/tvPeerDigitId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call timer (hidden until call is connected) -->
    <TextView
        android:id="@+id/tvTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:text="00:00"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvCallStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call controls: Mute | End | Speaker -->
    <LinearLayout
        android:id="@+id/llCallControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mute button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMute"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="16dp"
            app:icon="@drawable/ic_mic_on"
            app:iconSize="28dp" />

        <!-- End call button (red) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndCall"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="16dp"
            android:backgroundTint="@color/call_end"
            app:icon="@drawable/ic_call_end"
            app:iconSize="32dp" />

        <!-- Speaker button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeaker"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="16dp"
            app:icon="@drawable/ic_speaker_off"
            app:iconSize="28dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
